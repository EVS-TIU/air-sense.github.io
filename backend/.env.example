OPENWEATHER_API_KEY=
FRONTEND_URL=http://localhost:5500
ENVIRONMENT=development
PORT=8000
CACHE_TTL_SECONDS=300
HTTP_TIMEOUT_SECONDS=8
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Open-Meteo weather/air-quality map layers. No API key is required. Change
# these URLs only when routing through a self-hosted instance or proxy.
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# Optional free station-validation providers. Keep both tokens server-side.
# Register at aqicn.org/data-platform/token for WAQI and docs.openaq.org for OpenAQ.
WAQI_API_TOKEN=
OPENAQ_API_KEY=
AIR_QUALITY_CACHE_TTL_SECONDS=300
MAP_CACHE_TTL_SECONDS=300
MAP_AIR_CACHE_TTL_SECONDS=900
MAP_HISTORICAL_CACHE_TTL_SECONDS=3600
MAP_MAX_POINTS=400
MAP_MAX_BATCH_POINTS=100
