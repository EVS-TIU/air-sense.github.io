OPENWEATHER_API_KEY=
FRONTEND_URL=http://localhost:5500
ENVIRONMENT=development
PORT=8000
CACHE_TTL_SECONDS=300
HTTP_TIMEOUT_SECONDS=8
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional LLM for AI-written insight text (chat assistant + prediction
# overview). OpenRouter works out of the box:
#   1. Get a key at https://openrouter.ai/keys
#   2. Set the three values below (keep the /chat/completions suffix)
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Prefer a small fast model here. The LLM is optional decoration and has a
# 5 s budget, so large models (e.g. gemma-3-27b-it) always time out and fall
# back to the deterministic insight while adding needless latency.
# LLM_MODEL=google/gemma-3-4b-it
# Never commit real keys — .env is gitignored; keep only placeholders here.

# Open-Meteo weather/air-quality map layers. No API key is required. Change
# these URLs only when routing through a self-hosted instance or proxy.
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# Optional free station-validation providers. Keep both tokens server-side.
# Register at aqicn.org/data-platform/token for WAQI and docs.openaq.org for OpenAQ.
WAQI_API_TOKEN=
OPENAQ_API_KEY=
AIR_QUALITY_CACHE_TTL_SECONDS=300
MAP_CACHE_TTL_SECONDS=300
MAP_AIR_CACHE_TTL_SECONDS=900
MAP_HISTORICAL_CACHE_TTL_SECONDS=3600
MAP_MAX_POINTS=400
MAP_MAX_BATCH_POINTS=100

# Optional Chronos-Bolt-mini zero-shot temperature forecaster. It is skipped
# automatically when the checkpoint (backend/models/chronos-bolt-mini) or the
# torch/chronos extras are missing, so the API runs without it.
# CHRONOS_ENABLED=true
# CHRONOS_MODEL_PATH=/absolute/path/to/backend/models/chronos-bolt-mini
# CHRONOS_CONTEXT_DAYS=180
# CHRONOS_WEIGHT=0.45


